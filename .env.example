# ============================================================
# IDENTIDADE DO PRODUTO (Roadmap V16 / ADR 011)
# ============================================================

# Nome exibido nos prompts dos agentes e na CLI. "GeminiClaw" será
# substituído futuramente (ADR 011); trocar aqui não exige alterar código.
APP_NAME=GeminiClaw

# ============================================================
# CONFIGURAÇÃO DO PROVEDOR LLM (Roadmap V4)
# ============================================================

# Provedor ativo: google | ollama | local
# Use 'ollama' para inferência local no Raspberry Pi 5
LLM_PROVIDER=google

# Modelo a usar (depende do provedor)
# Para Ollama no Pi 5: qwen3.5:4b (recomendado — melhor tool calling no Pi 5)
# Para Google: gemini-2.0-flash, gemini-2.0-pro
LLM_MODEL=gemini-2.0-flash

# Model Router por Papel (Roadmap V14 - ADR 007)
RESEARCHER_PROVIDER=google
RESEARCHER_MODEL=gemini-2.0-flash
VALIDATOR_PROVIDER=ollama
VALIDATOR_MODEL=qwen3:8b
DEVELOPER_PROVIDER=google
DEVELOPER_MODEL=gemini-2.0-flash

# URL do servidor Ollama (quando LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Tamanho do contexto em tokens (Ollama)
# 4096 é seguro para 8 GB. Reduzir para 2048 se houver OOM.
# NÃO exceder 8192 sem monitorar o uso de RAM.
OLLAMA_NUM_CTX=4096

# Modo thinking (raciocínio) para modelos Qwen3.5/Ollama
# Se true, habilita thinking para agentes de execução.
# NOTA: Agentes 'planner' e 'validator' sempre usam thinking=true ignorando esta variável.
OLLAMA_ENABLE_THINKING=false

# Chave da API do Google (obrigatória apenas quando LLM_PROVIDER=google)
GEMINI_API_KEY=your_api_key_here

# Servidor compatível com a API da OpenAI (llama.cpp server, vLLM, LM Studio,
# serviços hospedados compatíveis) — usado quando algum papel/LLM_PROVIDER é
# 'openai_compatible'. Inclua o prefixo de versão da API do servidor (ex.: /v1).
OPENAI_BASE_URL=http://localhost:8000/v1
# Opcional: alguns servidores locais não exigem chave.
OPENAI_API_KEY=

# Rate limiting (substitui GEMINI_REQUESTS_PER_MINUTE)
# Para Ollama local, controla a taxa de requisições ao Pi 5
LLM_REQUESTS_PER_MINUTE=15
LLM_RATE_LIMIT_COOLDOWN_SECONDS=30
MAX_LOCAL_LLM_CONCURRENT=2

# ============================================================
# PERFIL DE DEPLOYMENT
# ============================================================
# Valores: default | pi5
# pi5: ajusta automaticamente timeouts, concorrência e limites de subtarefas
DEPLOYMENT_PROFILE=default

# ============================================================
# PERFIL DE SESSÃO (Roadmap V15.6 / Spec G10)
# ============================================================
# Nível de autonomia padrão quando --mode não é informado na CLI.
# Valores: assisted (padrão) | semi | auto
# - assisted: consulta o pesquisador quando o contexto está genuinamente ausente
# - semi: nunca bloqueia, documenta suposições e continua
# - auto: totalmente autônomo, resolve incertezas via busca web técnica
# Ambientes headless (ex: servidores sem pesquisador disponível) podem usar 'semi' ou 'auto'.
SESSION_DEFAULT_MODE=assisted

# ============================================================
# HUMAN-IN-THE-LOOP (Roadmap V15.3 / Spec G5)
# ============================================================
# Habilita a ferramenta ask_researcher para Researcher e Developer.
SKILL_HUMAN_FEEDBACK_ENABLED=true

# Limites operacionais monitorados por ciclo de planejamento. Não-bloqueantes por
# padrão — apenas o modo 'assisted' pausa e pergunta se deseja suspender a sessão.
# São percentuais do UsageBudget efetivo da sessão (ver seção V18 abaixo).
OPERATIONAL_THRESHOLD_TOKEN_USAGE_PCT=0.80
OPERATIONAL_THRESHOLD_COST_USD=5.0
OPERATIONAL_THRESHOLD_SESSION_DURATION_PCT=0.5
OPERATIONAL_THRESHOLD_CONTAINER_COUNT_PCT=0.85
# Tempo (segundos) que a CLI aguarda a resposta do pesquisador ao aviso de limite.
OPERATIONAL_THRESHOLD_WAIT_SECONDS=30
# Similaridade textual mínima (0-1) para reaproveitar a resposta de uma pergunta
# anterior similar na mesma sessão, sem perguntar de novo.
ASK_RESEARCHER_DEDUP_SIMILARITY=0.85

# ============================================================
# ORÇAMENTO DE USO DA SESSÃO (V18 / Spec usage-limits)
# ============================================================
# UsageBudget/UsageTracker (src/usage.py) tornam estes limites condições de parada
# reais da sessão (ver src/autonomous_loop.py). Ajustáveis também via CLI:
# --max-tokens, --max-minutes, --max-task-retries, --max-connection-retries.
# SESSION_MAX_TOKENS substitui MAX_SESSION_TOKENS (aceito como alias).
SESSION_MAX_TOKENS=500000
# Limite de tempo de relógio da sessão, em minutos.
SESSION_MAX_MINUTES=120
# SESSION_MAX_TASK_RETRIES substitui MAX_RETRY_PER_SUBTASK (aceito como alias).
SESSION_MAX_TASK_RETRIES=3
# Retentativas de conexão acumuladas na sessão (provedores LLM + sandbox Docker).
SESSION_MAX_CONNECTION_RETRIES=20
# Fração de SESSION_MAX_TOKENS reservada para o fechamento (checkpoint + consolidação).
SESSION_CLOSING_RESERVE_PCT=0.05
# Carência (segundos) para subtarefas em andamento terminarem após o limite de tempo.
LIMIT_GRACE_SECONDS=120

# ============================================================
# POSTGRESQL (Roadmap V8)
# ============================================================
POSTGRES_USER=geminiclaw
POSTGRES_PASSWORD=geminiclaw_secret
POSTGRES_DB=geminiclaw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL completa usada pelo código Python.
# Quando rodando no host: @localhost
# Quando rodando em container filho: @geminiclaw-postgres
DATABASE_URL=postgresql://geminiclaw:geminiclaw_secret@localhost:5432/geminiclaw

# ============================================================
# CONFIGURAÇÕES DO PROJETO (Geral)
# ============================================================
# Timeout para resposta do agente (opcional: perfil 'pi5' assume infinito)
# AGENT_TIMEOUT_SECONDS=300
STRICT_VALIDATION=true
MAX_CONCURRENT_AGENTS=3
DOCKER_IMAGE_BASE=geminiclaw-agent-base:latest
OUTPUT_BASE_DIR=./outputs
LOG_LEVEL=INFO
SEARCH_CACHE_TTL_SECONDS=3600

# Deep Search Skill (S2)
SKILL_DEEP_SEARCH_ENABLED=false
DEEP_SEARCH_DOMAINS=docs.python.org,arxiv.org
DEEP_SEARCH_MAX_PAGES_PER_DOMAIN=50
DEEP_SEARCH_CACHE_TTL_SECONDS=86400
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Embeddings locais (Roadmap V16 / ADR 011 §3) — ver src/embeddings/
# EMBEDDING_CACHE_DIR=~/.cache/geminiclaw/embeddings
EMBEDDING_BATCH_SIZE=32
# true no Pi 5 após o pré-download do modelo por scripts/setup_pi.sh — impede
# qualquer tentativa de download em tempo de execução.
EMBEDDING_OFFLINE=false

# Fallback para QuickSearch (Etapa V13)
QUICK_SEARCH_STRATEGY=ddg,ddg_lite,brave
BRAVE_API_KEY=

# Code Execution Skill (S3)
SKILL_CODE_ENABLED=true
CODE_SANDBOX_TIMEOUT_SECONDS=60
CODE_SANDBOX_MEMORY_LIMIT=256m

# Skills (Roadmap V3 - Etapa V5)
SKILL_WEB_READER_ENABLED=true

# Monitoramento de Saúde do Raspberry Pi 5 (S7)
HEALTH_CHECK_ENABLED=true
PI_TEMPERATURE_LIMIT=75.0
PI_MIN_AVAILABLE_MEMORY_MB=512.0

# Memory (S4 + S5)
SKILL_MEMORY_ENABLED=true
# LONG_TERM_MEMORY_DB removido: usa PostgreSQL via DATABASE_URL

# LLM Response Cache (Etapa V12)
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=1000

# Loop autônomo (S7)
# MAX_RETRY_PER_SUBTASK é alias de retrocompatibilidade de SESSION_MAX_TASK_RETRIES
# (definida acima); mantido aqui comentado para não conflitar com o valor efetivo.
# MAX_RETRY_PER_SUBTASK=3
MAX_SUBTASKS_PER_TASK=10

# Limites de planejamento (Roadmap V4)
MAX_PLANNING_ITERATIONS=10
MAX_PLAN_RETRIES=5

# Triage local sem container (Roadmap V3 - Etapa V3)
# Modos disponíveis: heuristic | llm | hybrid (padrão: hybrid)
TRIAGE_MODE=hybrid
TRIAGE_CONFIDENCE_THRESHOLD=0.7
CONTEXT_COMPRESSION_MODE=truncate

# ============================================================
# VEREDITO DE EVIDÊNCIA (Roadmap V17 / ADR 015 §9)
# ============================================================
# Parâmetros calibráveis da equação de confiança usada por src/knowledge/verdict.py
# para transformar as tentativas de uma hipótese num veredito de -1 a +1.
# Ver ADR 015 §9.8 para a tabela de referência.

# q — qualidade da validação
VERDICT_Q_VALIDATED_COMPLETE=1.0
VERDICT_Q_VALIDATED_INCOMPLETE=0.7
VERDICT_Q_DIVERGENT=0.3

# d — independência (nó/dataset novo > sessão nova > semente nova)
VERDICT_D_NEW_NODE_OR_DATASET=1.0
VERDICT_D_NEW_SESSION=0.5
VERDICT_D_NEW_SEED=0.2

# gamma — penalidade de busca (b); lambda — peso das tentativas ambíguas no fator f
VERDICT_GAMMA=0.5
VERDICT_LAMBDA_AMBIGUOUS=0.5

# Falha de abordagem reproduzida: q atribuído e nº mínimo de repetições independentes
VERDICT_APPROACH_FAILURE_Q=0.3
VERDICT_APPROACH_FAILURE_MIN_REPEATS=2

# Ponto de partida neutro de alpha/beta
VERDICT_PRIOR=1.0

# Limiares (fraco, moderado, forte) que definem as faixas de leitura do veredito
VERDICT_THRESHOLDS=0.1,0.3,0.5

# ============================================================
# GITHUB APP — Agente Colaborador (Skill github_app)
# ============================================================
# ID numérico do GitHub App (visível na página do App em github.com/settings/apps)
GITHUB_APP_ID=your_app_id_here

# ID da instalação do App no repositório
# Encontrado na URL: github.com/settings/installations/<INSTALLATION_ID>
GITHUB_APP_INSTALLATION_ID=your_installation_id_here

# Caminho absoluto para o arquivo .pem gerado pelo GitHub App
# NUNCA versione este arquivo. Salve fora do repositório.
GITHUB_APP_PRIVATE_KEY_PATH=/home/agent/.config/geminiclaw/github-app.pem

# Repositório no formato owner/repo
GITHUB_REPO=paulormnas/geminiclaw

# Skill do Document Processor (V7)
SKILL_DOCUMENT_PROCESSOR_ENABLED=false
