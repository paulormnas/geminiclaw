# ============================================================
# IDENTIDADE DO PRODUTO (Roadmap V16 / ADR 011)
# ============================================================

# Nome exibido nos prompts dos agentes e na CLI. "GeminiClaw" será
# substituído futuramente (ADR 011); trocar aqui não exige alterar código.
APP_NAME=GeminiClaw

# ============================================================
# MODELOS POR PAPEL (ADR 017: catálogo de modelos e roteador)
# ============================================================
# O modelo de cada papel (researcher, developer, validator, reviewer, summarizer, base) é resolvido
# uma vez por sessão pelo roteador, a partir do catálogo versionado (src/llm/catalog.yaml), da política
# de dados e da disponibilidade (credencial/endpoint, lista de permissão e health check sem geração de
# texto). LLM_PROVIDER, LLM_MODEL e DEFAULT_MODEL foram REMOVIDOS: se ainda estiverem no ambiente,
# um WARNING único avisa que são ignoradas.

# Política de dados: self_hosted_only (padrão) descarta todo modelo de terceiros, mesmo com chave de
# API presente; third_party_allowed permite enviar prompts a provedores de nuvem (Gemini, Claude, GPT).
# Quem usava nuvem precisa declarar third_party_allowed.
LLM_DATA_POLICY=self_hosted_only

# Modo de roteamento: flexible (padrão; pin/dica inválidos viram WARNING e segue a preferência do
# catálogo) | strict (pins e conflitos fatais, dica do plano ignorada, fallback do Google desligado).
LLM_ROUTING=flexible

# Lista de permissão de provedores (separados por vírgula; não muda a preferência do papel, só exclui o
# que não está nela). Vazio = padrão do perfil: pi5 -> ollama,openai_compatible,google,anthropic,openai;
# default -> google,anthropic,openai,ollama,openai_compatible.
# LLM_PROVIDER_PRIORITY=

# Timeout (s) do health check de cada (provedor, modelo) no início da sessão (vale também dentro dos provedores).
LLM_HEALTH_CHECK_TIMEOUT_SECONDS=5

# Catálogo local opcional (só ACRESCENTA modelos; não altera entradas nem papéis; registrado por sha256
# no log). Vazio = src/llm/catalog.local.yaml (ignorado pelo git).
# LLM_CATALOG_LOCAL_PATH=

# Pin opcional por papel, no formato provedor/modelo (precisa existir no catálogo e passar pela política):
# RESEARCHER_MODEL=anthropic/claude-sonnet-5-5
# DEVELOPER_MODEL=google/gemini-3.8-flash
# VALIDATOR_MODEL=ollama/qwen3:8b
# REVIEWER_MODEL=
# SUMMARIZER_MODEL=
# BASE_MODEL=
# A CLI aceita --model provedor/modelo como pin do researcher.
#
# Exemplo de nuvem (Google para código, Claude para pesquisa e validação), conforme a ordem de preferência
# do catálogo; basta liberar a política e fornecer as chaves (GEMINI_API_KEY, ANTHROPIC_API_KEY):
# LLM_DATA_POLICY=third_party_allowed
#
# TRANSIÇÃO: <PAPEL>_PROVIDER + <PAPEL>_MODEL (sem "/") ainda valem como pin equivalente, com WARNING de
# obsolescência. Migre para <PAPEL>_MODEL=provedor/modelo e remova <PAPEL>_PROVIDER.

# URL do servidor Ollama (provedor 'ollama'; modelos locais do catálogo)
OLLAMA_BASE_URL=http://localhost:11434

# Tamanho do contexto em tokens (Ollama)
# 4096 é seguro para 8 GB. Reduzir para 2048 se houver OOM.
# NÃO exceder 8192 sem monitorar o uso de RAM.
OLLAMA_NUM_CTX=4096

# Modo thinking (raciocínio) para modelos Qwen3.5/Ollama
# Se true, habilita thinking para agentes de execução.
# NOTA: Agentes 'planner' e 'validator' sempre usam thinking=true ignorando esta variável.
OLLAMA_ENABLE_THINKING=false

# Modelo de fallback do Google quando o principal atinge o limite de requisições (429). Vazio desliga.
# Só vale se estiver no catálogo com o mesmo trust e atender aos requisitos do papel; desligado em strict.
GOOGLE_FALLBACK_MODEL=gemini-3.7-flash

# Chave da API do Google. Sem ela o provedor 'google' simplesmente não fica disponível para o roteador.
GEMINI_API_KEY=your_api_key_here

# OpenAI (provedor 'openai', ex.: gpt-6-luna): usa OPENAI_API_KEY (obrigatória) e, por padrão,
# https://api.openai.com/v1. Só defina OPENAI_BASE_URL para um proxy https da OpenAI; NÃO a aponte para
# um servidor local (a chave real seria enviada a ele).
# OPENAI_BASE_URL=
OPENAI_API_KEY=

# Provedor 'openai_compatible' (llama.cpp server, vLLM, LM Studio, serviços hospedados compatíveis):
# variáveis PRÓPRIAS, separadas das do 'openai' (a chave real da OpenAI nunca vai ao servidor compatível).
# O endpoint inclui o prefixo de versão (ex.: /v1) e, fora de loopback/rede privada, exige https
# (a mesma regra vale para OLLAMA_BASE_URL, ANTHROPIC_BASE_URL e OPENAI_BASE_URL). A chave é opcional.
# Um modelo deste provedor entra pelo catálogo local (LLM_CATALOG_LOCAL_PATH).
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=

# Esforço de raciocínio do provedor 'openai' (none | low | medium | high; vazio = não enviar).
# gpt-6-luna só aceita ferramentas em /chat/completions com 'none'.
OPENAI_REASONING_EFFORT=none

# Preços (USD por milhão de tokens) de modelos fora da tabela de src/llm/pricing.py, em JSON:
# {"provedor/modelo": [entrada, saida, entrada_em_cache]}. Sem preço, o custo aparece como n/d.
# LLM_PRICING_OVERRIDES=

# Anthropic (Claude) — usado quando algum papel do mapa resolvido é 'anthropic'.
# Requer o extra opcional: uv sync --extra anthropic
ANTHROPIC_API_KEY=
# Opcional: gateway/proxy compatível com a API da Anthropic (padrão: api.anthropic.com).
# ANTHROPIC_BASE_URL=
# Esforço do raciocínio adaptativo: low | medium | high | xhigh | max (vazio = não enviar).
ANTHROPIC_EFFORT=medium
# Repete, no servidor e em outro modelo, pedidos recusados pelos classificadores de segurança.
ANTHROPIC_REFUSAL_FALLBACK=true

# Rate limiting (substitui GEMINI_REQUESTS_PER_MINUTE)
# Para Ollama local, controla a taxa de requisições ao Pi 5
LLM_REQUESTS_PER_MINUTE=15
LLM_RATE_LIMIT_COOLDOWN_SECONDS=30
MAX_LOCAL_LLM_CONCURRENT=2

# ============================================================
# RUNTIME DE AGENTES (Roadmap V16 / ADR 014)
# ============================================================
# Os agentes executam dentro do processo do orquestrador (src/agent_runtime/); o único
# container é o sandbox de código. O número de agentes simultâneos é calculado pela RAM livre
# e limitado por MAX_CONCURRENT_AGENTS (e por MAX_LOCAL_LLM_CONCURRENT com Ollama).

# Limite de execuções de agente por sessão (circuit breaker).
MAX_AGENT_RUNS_PER_SESSION=30
# Limite de execuções de planejamento (Researcher em PLAN/REPLAN); o de subtarefas cresce com o plano
MAX_PLANNING_RUNS_PER_SESSION=20
# Robustez do pipeline (v16-pipeline-robustness)
PLAN_NORMALIZER_ENABLED=true
PLAN_REJECTION_STALL_LIMIT=2
ARTIFACT_MATCH_MODE=tolerant
CIRCUIT_BREAKER_STALL_CYCLES=2
# Avaliação da comunicação entre agentes (pós-execução; scripts/benchmark/communication.py)
# O juiz LLM é selecionado automaticamente (modelo diferente do desenvolvedor e do planejamento).
# Sobrescrita opcional do juiz (precisa ser diferente dos modelos do developer e do researcher):
COMM_EVAL_JUDGE_PROVIDER=
COMM_EVAL_JUDGE_MODEL=
# Candidatos extras ao juiz, "provedor/modelo" separados por vírgula (padrão vazio)
COMM_EVAL_JUDGE_CANDIDATES=
# Juiz fora do nó (provedor de nuvem) só roda com opt-in explícito e teto de custo > 0
COMM_EVAL_ALLOW_EXTERNAL_JUDGE=false
COMM_EVAL_MAX_USD=0
COMM_EVAL_JUDGE_CONTEXT_CHARS=400
COMM_EVAL_CALIBRATION_SIZE=20
COMM_EVAL_MIN_KAPPA=0.6
COMM_EVAL_LOOP_MIN_LENGTH=3

# ============================================================
# PERFIL DE DEPLOYMENT
# ============================================================
# Valores: default | pi5
# pi5: ajusta automaticamente timeouts, concorrência e limites de subtarefas
DEPLOYMENT_PROFILE=default

# ============================================================
# PERFIL DE SESSÃO (Roadmap V15.6 / Spec G10)
# ============================================================
# Nível de autonomia padrão quando --mode não é informado na CLI.
# Valores: assisted (padrão) | semi | auto
# - assisted: consulta o pesquisador quando o contexto está genuinamente ausente
# - semi: nunca bloqueia, documenta suposições e continua
# - auto: totalmente autônomo, resolve incertezas via busca web técnica
# Ambientes headless (ex: servidores sem pesquisador disponível) podem usar 'semi' ou 'auto'.
SESSION_DEFAULT_MODE=assisted

# ============================================================
# HUMAN-IN-THE-LOOP (Roadmap V15.3 / Spec G5)
# ============================================================
# Habilita a ferramenta ask_researcher para Researcher e Developer.
SKILL_HUMAN_FEEDBACK_ENABLED=true

# Limites operacionais monitorados por ciclo de planejamento. Não-bloqueantes por
# padrão — apenas o modo 'assisted' pausa e pergunta se deseja suspender a sessão.
# São percentuais do UsageBudget efetivo da sessão (ver seção V18 abaixo).
OPERATIONAL_THRESHOLD_TOKEN_USAGE_PCT=0.80
OPERATIONAL_THRESHOLD_COST_USD=5.0
OPERATIONAL_THRESHOLD_SESSION_DURATION_PCT=0.5
OPERATIONAL_THRESHOLD_AGENT_RUNS_PCT=0.85
# Tempo (segundos) que a CLI aguarda a resposta do pesquisador ao aviso de limite.
OPERATIONAL_THRESHOLD_WAIT_SECONDS=30
# Similaridade textual mínima (0-1) para reaproveitar a resposta de uma pergunta
# anterior similar na mesma sessão, sem perguntar de novo.
ASK_RESEARCHER_DEDUP_SIMILARITY=0.85

# ============================================================
# ORÇAMENTO DE USO DA SESSÃO (V18 / Spec usage-limits)
# ============================================================
# UsageBudget/UsageTracker (src/usage.py) tornam estes limites condições de parada
# reais da sessão (ver src/autonomous_loop.py). Ajustáveis também via CLI:
# --max-tokens, --max-minutes, --max-task-retries, --max-connection-retries.
# SESSION_MAX_TOKENS substitui MAX_SESSION_TOKENS (aceito como alias).
SESSION_MAX_TOKENS=500000
# Limite de tempo de relógio da sessão, em minutos.
SESSION_MAX_MINUTES=120
# SESSION_MAX_TASK_RETRIES substitui MAX_RETRY_PER_SUBTASK (aceito como alias).
SESSION_MAX_TASK_RETRIES=3
# Retentativas de conexão acumuladas na sessão (provedores LLM + sandbox Docker).
SESSION_MAX_CONNECTION_RETRIES=20
# Fração de SESSION_MAX_TOKENS reservada para o fechamento (checkpoint + consolidação).
SESSION_CLOSING_RESERVE_PCT=0.05
# Continuidade da pesquisa (v18-research-continuity): batimento da sessão e detecção de parada inesperada.
SESSION_HEARTBEAT_SECONDS=30
SESSION_STALE_SECONDS=300
# Carência (segundos) para subtarefas em andamento terminarem após o limite de tempo.
LIMIT_GRACE_SECONDS=120

# ============================================================
# POSTGRESQL (Roadmap V8)
# ============================================================
POSTGRES_USER=geminiclaw
POSTGRES_PASSWORD=geminiclaw_secret
POSTGRES_DB=geminiclaw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL completa usada pelo código Python.
# Quando rodando no host: @localhost
# Quando rodando em container filho: @geminiclaw-postgres
DATABASE_URL=postgresql://geminiclaw:geminiclaw_secret@localhost:5432/geminiclaw

# ============================================================
# GRAFO DE CONHECIMENTO — Apache AGE (Roadmap V17 / ADR 009, ADR 015)
# ============================================================
# Nome do grafo AGE dentro do PostgreSQL (sem o nome do produto, ADR 011).
KNOWLEDGE_GRAPH_NAME=knowledge

# Senha do papel somente-leitura `knowledge_reader`, criado pela migração
# v17_001 (scripts/migrations/v17_001_knowledge_graph.sql). Gere uma senha
# própria por ambiente — nunca reutilize POSTGRES_PASSWORD.
KNOWLEDGE_READER_PASSWORD=change_me_knowledge_reader

# DSN completo do papel somente-leitura, usado por GraphStore.read_query
# (Curator, CLI). Mesmo host/porta/banco de DATABASE_URL, usuário/senha do
# papel knowledge_reader.
KNOWLEDGE_READER_DATABASE_URL=postgresql://knowledge_reader:change_me_knowledge_reader@localhost:5432/geminiclaw

# Timeout (ms) aplicado a toda consulta livre via read_query.
KNOWLEDGE_READ_TIMEOUT_MS=5000
# Ingestão de fatos: maior arquivo hasheado (bytes) e total hasheado por subtarefa/snapshot (bytes)
INGESTION_MAX_FILE_BYTES=268435456
INGESTION_MAX_HASH_BYTES_PER_CALL=1073741824

# Indexação automática dos insumos (input_snapshot/) na coleção de documentos, sem LLM, antes do planejamento.
# Tempo máximo por sessão (s; melhor esforço: o restante fica pendente), tamanho acima do qual só se grava o
# descritor (MB), tamanho acima do qual JSON/xlsx/parquet não são lidos por inteiro (MB) e tamanho máximo do
# cabeçalho enriquecido de cada trecho (caracteres).
INPUT_INDEX_ENABLED=true
INPUT_INDEX_MAX_SECONDS=300
INPUT_INDEX_MAX_FILE_MB=20
INPUT_INDEX_MAX_DATASET_MB=10
INPUT_INDEX_HEADER_MAX_CHARS=400

# Similaridade semântica mínima (0-1) para resolver um termo livre de domínio
# ou métrica a um termo canônico existente do vocabulário controlado. Abaixo
# disso, cria-se um candidato. Default 0.90 (faixa de duplicata).
VOCAB_MATCH_THRESHOLD=0.90

# Busca de domínio com embeddings hierárquicos (v17-domain-search).
# Resultados devolvidos por padrão (máximo 10).
DOMAIN_SEARCH_LIMIT=5
# Escore mínimo para devolver um domínio; depende do modelo de embedding (ajustar
# após `uv run python -m scripts.eval_domain_search`).
DOMAIN_SEARCH_MIN_SCORE=0.35
# Margem de escore em que o nível mais específico vence o mais amplo.
DOMAIN_SPECIFICITY_MARGIN=0.03
# Tamanho máximo (caracteres) da consulta e do contexto.
DOMAIN_SEARCH_MAX_QUERY_CHARS=300
# Descendentes marcados como pendentes por lote quando um ancestral muda.
DOMAIN_REINDEX_BATCH=200

# Tamanho máximo (caracteres) de um termo livre de vocabulário (domínio ou métrica) que vira
# candidato; termos maiores são recusados com erro explícito. Controles e quebras de linha
# são removidos antes.
VOCAB_TERM_MAX_CHARS=120

# Identificador estável deste computador (fator de independência, ADR 015 §9).
# Gerado automaticamente na primeira execução e persistido em
# ~/.config/geminiclaw/node_id — normalmente não precisa ser definido aqui;
# use esta variável apenas para fixar um valor específico (ex.: em containers
# efêmeros que não compartilham $HOME com o host).
# NODE_ID=

# ============================================================
# CONFIGURAÇÕES DO PROJETO (Geral)
# ============================================================
# Timeout para resposta do agente (opcional: perfil 'pi5' assume infinito)
# AGENT_TIMEOUT_SECONDS=300
MAX_CONCURRENT_AGENTS=3
OUTPUT_BASE_DIR=./outputs
LOG_LEVEL=INFO
SEARCH_CACHE_TTL_SECONDS=3600

# Deep Search Skill (S2)
SKILL_DEEP_SEARCH_ENABLED=false
DEEP_SEARCH_DOMAINS=docs.python.org,arxiv.org
DEEP_SEARCH_MAX_PAGES_PER_DOMAIN=50
DEEP_SEARCH_CACHE_TTL_SECONDS=86400
QDRANT_URL=http://localhost:6333
# Imagem do Qdrant no compose (padrão: oficial, multi-arch). Validada no Pi 5: v1.19.1 (ver README).
# QDRANT_IMAGE=qdrant/qdrant:v1.19.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Embeddings locais (Roadmap V16 / ADR 011 §3) — ver src/embeddings/
# EMBEDDING_CACHE_DIR=~/.cache/geminiclaw/embeddings
EMBEDDING_BATCH_SIZE=32
# true no Pi 5 após o pré-download do modelo por scripts/setup_pi.sh — impede
# qualquer tentativa de download em tempo de execução.
EMBEDDING_OFFLINE=false

# ============================================================
# ÍNDICE SEMÂNTICO DO GRAFO (Roadmap V17 / ADR 015 §6)
# ============================================================
# Coleção Qdrant com um ponto por nó vetorizável (ID do ponto = ID do nó).
KNOWLEDGE_COLLECTION=knowledge_nodes
# Faixas de similaridade (cosseno). Dependem do modelo de embedding: calibre
# com `geminiclaw knowledge stats` (o sistema só sugere, nunca altera).
SIM_DUPLICATE_MIN=0.90
SIM_RELATED_MIN_SAME_DOMAIN=0.70
SIM_RELATED_MIN_CROSS=0.60
# |veredito| mínimo da Descoberta para pares Descoberta->Problema de outro projeto.
SIM_CROSS_PROJECT_MIN_CONFIDENCE=0.30
# Multiplicador de prioridade da fila para pares entre domínios diferentes.
SIM_CROSS_DOMAIN_BOOST=1.5
# Vizinhos buscados por página na varredura de candidatos (a varredura pagina; não há teto de candidatos).
SIM_CANDIDATE_SCAN_LIMIT=200
# Janela (dias) da taxa de confirmação mostrada por `geminiclaw knowledge stats`.
SIM_CALIBRATION_WINDOW_DAYS=30
# Consulta híbrida (related_experience): meia-vida da recência e piso de confiança.
RECENCY_HALF_LIFE_DAYS=365
CONFIDENCE_FLOOR=0.05
# Nós lidos do grafo por página na reconciliação do índice (limita a memória no Pi 5).
SIM_RECONCILE_BATCH_SIZE=200
# Pares revisados mínimos na faixa para `knowledge stats` sugerir ajuste de limiar.
SIM_CALIBRATION_MIN_SAMPLES=10
# Liga o índice semântico ao GraphStore de produção (escritas passam pelo gancho de vetorização).
KNOWLEDGE_SEMANTIC_INDEX_ENABLED=true

# Projeto de pesquisa (v17-research-project): padrão false = toda sessão exige o grafo de conhecimento.
# true = se (e só se) o grafo não abrir, a sessão roda SEM projeto (banner e project_mode="sem_grafo");
# com o grafo acessível a confirmação humana do Problema continua obrigatória.
RESEARCH_PROJECT_GRAPH_OPTIONAL=false

# Fallback para QuickSearch (Etapa V13)
QUICK_SEARCH_STRATEGY=ddg,ddg_lite,brave
BRAVE_API_KEY=

# Code Execution Skill (S3)
SKILL_CODE_ENABLED=true
CODE_SANDBOX_TIMEOUT_SECONDS=60
# Limite da instalação de pacotes (packages) no sandbox; ao estourar, o container é encerrado
CODE_SANDBOX_SETUP_TIMEOUT_SECONDS=300
CODE_SANDBOX_MEMORY_LIMIT=256m
# Imagem do sandbox (construída por scripts/build_images.sh a partir de containers/sandbox)
SANDBOX_IMAGE=code-sandbox:latest
# Diretórios temporários por execução (pacotes instalados sob demanda em /deps); removidos ao fim
SANDBOX_WORK_DIR=store/sandbox_work
# Limite de processos e tamanho do /tmp (tmpfs) do container do sandbox
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMPFS_SIZE=256m
# Linhas finais do log do uv devolvidas quando a instalação de pacotes falha
SANDBOX_INSTALL_LOG_TAIL_LINES=40

# Skills (Roadmap V3 - Etapa V5)
SKILL_WEB_READER_ENABLED=true

# Monitoramento de Saúde do Raspberry Pi 5 (S7)
HEALTH_CHECK_ENABLED=true
PI_TEMPERATURE_LIMIT=75.0
PI_MIN_AVAILABLE_MEMORY_MB=512.0

# Memory (S4 + S5)
SKILL_MEMORY_ENABLED=true
# LONG_TERM_MEMORY_DB removido: usa PostgreSQL via DATABASE_URL

# LLM Response Cache (Etapa V12)
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=1000

# Loop autônomo (S7)
# MAX_RETRY_PER_SUBTASK é alias de retrocompatibilidade de SESSION_MAX_TASK_RETRIES
# (definida acima); mantido aqui comentado para não conflitar com o valor efetivo.
# MAX_RETRY_PER_SUBTASK=3
MAX_SUBTASKS_PER_TASK=10

# Limites de planejamento (Roadmap V4)
MAX_PLANNING_ITERATIONS=10
# Planos consecutivos rejeitados pelo Validator que encerram a exploração (v18-hypothesis-loop)
MAX_PLAN_RETRIES=5

# Triage local sem container (Roadmap V3 - Etapa V3)
# Modos disponíveis: heuristic | llm | hybrid (padrão: hybrid)
TRIAGE_MODE=hybrid
TRIAGE_CONFIDENCE_THRESHOLD=0.7
CONTEXT_COMPRESSION_MODE=truncate

# ============================================================
# VEREDITO DE EVIDÊNCIA (Roadmap V17 / ADR 015 §9)
# ============================================================
# Parâmetros calibráveis da equação de confiança usada por src/knowledge/verdict.py
# para transformar as tentativas de uma hipótese num veredito de -1 a +1.
# Ver ADR 015 §9.8 para a tabela de referência.

# q — qualidade da validação
VERDICT_Q_VALIDATED_COMPLETE=1.0
VERDICT_Q_VALIDATED_INCOMPLETE=0.7
VERDICT_Q_DIVERGENT=0.3

# d — independência (nó/dataset novo > sessão nova > semente nova)
VERDICT_D_NEW_NODE_OR_DATASET=1.0
VERDICT_D_NEW_SESSION=0.5
VERDICT_D_NEW_SEED=0.2

# gamma — penalidade de busca (b); lambda — peso das tentativas ambíguas no fator f
VERDICT_GAMMA=0.5
VERDICT_LAMBDA_AMBIGUOUS=0.5

# Falha de abordagem reproduzida: q atribuído e nº mínimo de repetições independentes
VERDICT_APPROACH_FAILURE_Q=0.3
VERDICT_APPROACH_FAILURE_MIN_REPEATS=2

# Ponto de partida neutro de alpha/beta
VERDICT_PRIOR=1.0

# Limiares (fraco, moderado, forte) que definem as faixas de leitura do veredito
VERDICT_THRESHOLDS=0.1,0.3,0.5

# ============================================================
# AGENTE CURATOR (Roadmap V17 / ADR 012, ADR 015 §10 — v17-curator-agent)
# ============================================================
# O modelo do papel `curator` sai do catálogo (src/llm/catalog.yaml). Para fixá-lo: CURATOR_MODEL=provedor/modelo
# Liga/desliga o Curator (os recálculos determinísticos de veredito continuam rodando).
CURATOR_ENABLED=true
# Limites por execução do Curator (consolidate/close_session): chamadas de ferramenta, tokens e pares da fila.
CURATOR_MAX_ITERATIONS=20
CURATOR_MAX_TOKENS_PER_RUN=30000
CURATOR_QUEUE_BATCH=20
# Escritas no grafo e consultas livres (somente leitura) por execução.
CURATOR_MAX_WRITES_PER_RUN=30
CURATOR_MAX_READ_QUERIES_PER_RUN=5
# Mudanças de status de descobertas (contestar/substituir) por execução.
CURATOR_MAX_STATUS_CHANGES_PER_RUN=3
# Tamanho máximo de cada texto aceito pelas ferramentas de escrita (recusa, não trunca) e da saída das ferramentas.
CURATOR_MAX_TEXT_CHARS=1000
CURATOR_MAX_TOOL_OUTPUT_CHARS=6000
CURATOR_TIMEOUT_SECONDS=300
# Sinalizações dos outros agentes (flag_for_curator): máximo por sessão e tamanho do texto.
CURATOR_MAX_FLAGS_PER_SESSION=100
CURATOR_FLAG_MAX_CHARS=1000
# Menor |veredito| que mantém os atalhos FUNCIONOU_PARA/FALHOU_PARA.
KNOWLEDGE_SHORTCUT_MIN_VERDICT=0.1
# Promoção de configuração a Abordagem: resultados positivos validados e projetos distintos.
PROMOTION_MIN_POSITIVES=3
PROMOTION_MIN_PROJECTS=2

# ============================================================
# GITHUB APP — Agente Colaborador (Skill github_app)
# ============================================================
# ID numérico do GitHub App (visível na página do App em github.com/settings/apps)
GITHUB_APP_ID=your_app_id_here

# ID da instalação do App no repositório
# Encontrado na URL: github.com/settings/installations/<INSTALLATION_ID>
GITHUB_APP_INSTALLATION_ID=your_installation_id_here

# Caminho absoluto para o arquivo .pem gerado pelo GitHub App
# NUNCA versione este arquivo. Salve fora do repositório.
GITHUB_APP_PRIVATE_KEY_PATH=/home/agent/.config/geminiclaw/github-app.pem

# Repositório no formato owner/repo
GITHUB_REPO=paulormnas/geminiclaw

# Skill do Document Processor (V7)
SKILL_DOCUMENT_PROCESSOR_ENABLED=false

# ============================================================
# Researcher consultor nos modos semi/auto (V18 / ADR 012 §8)
# ============================================================
# Em semi/auto, ask_researcher chama o Researcher (LLM do papel researcher) em vez de devolver
# só a suposição documentada. false = comportamento anterior.
RESEARCHER_CONSULT_ENABLED=true
# false = o consultor responde sem busca na web
RESEARCHER_CONSULT_WEB_ENABLED=true
# Consultas ao Researcher por sessão (respostas reaproveitadas não contam)
RESEARCHER_CONSULT_MAX_PER_SESSION=10
# Buscas e leituras de página por consulta
RESEARCHER_CONSULT_MAX_SEARCHES=3
RESEARCHER_CONSULT_MAX_READS=2
RESEARCHER_CONSULT_TIMEOUT_SECONDS=120
# Tamanho máximo do texto enviado ao buscador (guarda de consulta)
RESEARCHER_CONSULT_QUERY_MAX_CHARS=120
# Hosts permitidos para web_reader nas consultas (sufixos, separados por vírgula); vazio = sem lista
RESEARCHER_CONSULT_ALLOWED_HOSTS=
# true = web_reader só lê hosts que apareceram em resultado de quick_search da mesma consulta
RESEARCHER_CONSULT_READ_ONLY_SEARCHED_HOSTS=false

# ============================================================
# CLI do grafo (Roadmap V17 — v17-graph-cli)
# ============================================================
# `geminiclaw graph show|node` (sem LLM): máximo de nós por saída (acima disso trunca com aviso) e de caracteres por texto.
GRAPH_SHOW_MAX_NODES=200
GRAPH_SHOW_MAX_TEXT_CHARS=200
# `geminiclaw graph edit` (Curator propõe; o pesquisador confirma): rodadas de proposta (ajustes), operações por
# proposta e tamanho máximo do pedido.
GRAPH_EDIT_MAX_ROUNDS=3
GRAPH_EDIT_MAX_OPS=20
GRAPH_EDIT_MAX_REQUEST_CHARS=2000
# Máximo de caracteres de uma proposta exibida por inteiro (acima disso é recusada, nunca truncada).
GRAPH_EDIT_MAX_DISPLAY_CHARS=8000

# ============================================================
# Ciclo de hipóteses e exploração ativa (Roadmap V18 — v18-hypothesis-loop)
# ============================================================
# false = volta ao laço de ciclo único (sem hipóteses, sugestões nem exploração contínua).
HYPOTHESIS_LOOP_ENABLED=true
# Pesos da prioridade de hipóteses (relevância, apoio prévio, novidade, 1-custo); devem somar 1.
HYPOTHESIS_PRIORITY_WEIGHTS=0.35,0.30,0.20,0.15
# Hipóteses executadas por ciclo nos modos semi/auto (as de maior prioridade).
HYPOTHESES_PER_CYCLE=2
# Similaridade a partir da qual uma hipótese nova reutiliza a existente do projeto.
HYPOTHESIS_DEDUP_SIMILARITY=0.90
# |veredito| que avalia a Decisao escolhida e leva a hipótese a validada/refutada.
DECISION_EVAL_MIN_VERDICT=0.3
# Sugestões do Curator ao Researcher por ciclo.
CURATOR_MAX_SUGGESTIONS=3
# Veredito mínimo (evidência moderada) para a solução ser considerada encontrada.
SOLUTION_MIN_VERDICT=0.3
# Teto de ciclos de exploração por sessão (à prova de laço infinito; fecha com limite_execucoes).
MAX_EXPLORATION_CYCLES=20
# Tamanho máximo de texto de hipótese/decisão aceito do plano e quantidades máximas por plano.
HYPOTHESIS_TEXT_MAX_CHARS=1000
HYPOTHESES_MAX_PER_PLAN=10
DECISIONS_MAX_PER_PLAN=10
