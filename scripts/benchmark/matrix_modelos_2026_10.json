{
  "task_file": "scripts/benchmark/task_iris.txt",
  "timeout_seconds": 12000,
  "budget_usd": {"anthropic": 14.0, "openai": 8.0},
  "env": {
    "ANTHROPIC_EFFORT": "medium",
    "LOCALITY_MIN_GROUP_SIZE": "10",
    "LLM_REQUESTS_PER_MINUTE": "60",
    "SESSION_MAX_TOKENS": "3000000",
    "SESSION_MAX_MINUTES": "180",
    "GOOGLE_FALLBACK_MODEL": "",
    "OPENAI_REASONING_EFFORT": "none"
  },
  "combinations": [
    {"name": "gemini-3.8-flash", "roles": {"*": "google/gemini-3.8-flash"}},
    {"name": "claude-haiku-5-5", "roles": {"*": "anthropic/claude-haiku-5-5"}, "requires": "ANTHROPIC_API_KEY"},
    {"name": "gpt-5.6-terra", "roles": {"*": "openai/gpt-5.6-terra"}, "requires": "OPENAI_API_KEY"},
    {"name": "gpt-6-luna-xhigh", "roles": {"*": "openai/gpt-6-luna"}, "requires": "OPENAI_API_KEY",
     "env": {"OPENAI_REASONING_EFFORT": "xhigh"}},
    {"name": "claude-sonnet-5-5", "roles": {"*": "anthropic/claude-sonnet-5-5"}, "requires": "ANTHROPIC_API_KEY"}
  ]
}
